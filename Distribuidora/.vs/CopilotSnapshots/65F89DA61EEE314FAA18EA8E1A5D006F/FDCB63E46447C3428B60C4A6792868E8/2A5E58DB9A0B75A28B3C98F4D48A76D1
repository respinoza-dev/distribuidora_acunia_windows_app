using Microsoft.Data.SqlClient;
using SistemaGestion.DAL.Configuration;
using SistemaGestion.DAL.Entities;

namespace SistemaGestion.DAL.Repository
{
    public class ProductRepository
    {
        private const string SqlBase =
            @"SELECT p.Id_Producto, p.Nombre_Producto, m.Nombre_Marca,
                     p.Descripcion, p.precio_Detalle, p.Stock_Actual, p.Presentacion
              FROM   Producto p
              LEFT JOIN Marca m ON p.Id_Marca = m.Id_Marca
              WHERE  p.Activo = 1";

        public List<Producto> ObtenerLista()
        {
            var lista = new List<Producto>();
            try
            {
                using (SqlConnection connection = DBConnection.Connect())
                {
                    connection.Open();
                    SqlCommand cmd = new SqlCommand(SqlBase, connection);
                    SqlDataReader reader = cmd.ExecuteReader();
                    while (reader.Read())
                    {
                        lista.Add(MapearProducto(reader));
                    }
                    connection.Close();
                }
            }
            catch (Exception)
            {
                throw;
            }
            return lista;
        }

        public List<Producto> BuscarPorNombre(string nombre)
        {
            var lista = new List<Producto>();
            try
            {
                using (SqlConnection connection = DBConnection.Connect())
                {
                    connection.Open();
                    string sql = SqlBase + " AND p.Nombre_Producto LIKE @Nombre";
                    SqlCommand cmd = new SqlCommand(sql, connection);
                    cmd.Parameters.AddWithValue("@Nombre", $"%{nombre}%");
                    SqlDataReader reader = cmd.ExecuteReader();
                    while (reader.Read())
                    {
                        lista.Add(MapearProducto(reader));
                    }
                    connection.Close();
                }
            }
            catch (Exception)
            {
                throw;
            }
            return lista;
        }

        private Producto MapearProducto(SqlDataReader reader)
        {
            return new Producto
            {
                Id          = Convert.ToInt32(reader["Id_Producto"]),
                Nombre      = reader["Nombre_Producto"].ToString()!,
                Marca       = reader["Nombre_Marca"] == DBNull.Value ? string.Empty : reader["Nombre_Marca"].ToString()!,
                Descripcion = reader["Descripcion"].ToString()!,
                Tamanio     = 0,
                Modelo      = reader["Presentacion"].ToString()!,
                Precio      = Convert.ToDouble(reader["precio_Detalle"]),
                StockDisponible = Convert.ToInt32(reader["Stock_Actual"])
            };
        }
    }
}
